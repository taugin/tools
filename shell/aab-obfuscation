#!/usr/bin/env bash

set -u

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"
python_script="$repo_root/script/android/check_aab_obfuscation.py"

if command -v python3 >/dev/null 2>&1; then
    python_path="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
    python_path="$(command -v python)"
else
    echo "[错误] 未找到 Python 3，请先安装 python3。" >&2
    exit 2
fi

if [ ! -f "$python_script" ]; then
    echo "[错误] 找不到检测脚本：$python_script" >&2
    exit 2
fi

python_version="$("$python_path" --version 2>&1)"
echo [Logging...] 脚本文件路径 : [$python_path]
echo [Logging...] 脚本文件版本 : [$python_version]
echo [Logging...] 脚本代码路径 : [$python_script]
echo

exec "$python_path" "$python_script" "$@"
